{
  "name": "@civicresolve/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var DEMO_MODE:true",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply civicresolve-local --local"
  },
  "dependencies": {
    "@civicresolve/contracts": "workspace:*",
    "@civicresolve/domain": "workspace:*",
    "@civicresolve/fixtures": "workspace:*",
    "jose": "^6.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250906.0",
    "wrangler": "^4.33.0"
  }
}
